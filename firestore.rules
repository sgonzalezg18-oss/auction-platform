rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= USUARIOS =================
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // ================= VEHICULOS =================
    match /vehiculos/{vehiculoId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.publicadorId == request.auth.uid
        && request.resource.data.imagenes == 5
        && request.resource.data.portada is string
        && request.resource.data.portada.size() < 950000;

      allow update: if request.auth != null
        && resource.data.publicadorId == request.auth.uid
        && request.resource.data.publicadorId == resource.data.publicadorId
        && request.resource.data.imagenes == 5;

      allow delete: if request.auth != null
        && resource.data.publicadorId == request.auth.uid
        && !exists(/databases/$(database)/documents/subastas/$(vehiculoId));

      // Fotos 2..5 en subcoleccion
      match /fotos/{fotoId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && getAfter(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.publicadorId == request.auth.uid;
        allow delete: if request.auth != null
          && get(/databases/$(database)/documents/vehiculos/$(vehiculoId)).data.publicadorId == request.auth.uid;
      }
    }

    // ================= SUBASTAS (id del doc = vehiculoId) =================
    match /subastas/{subastaId} {
      allow read: if true;

      // CREAR: solo el dueño del vehiculo, precio base minimo Q.20,000
      allow create: if request.auth != null
        && request.resource.data.vehiculoId == subastaId
        && request.resource.data.creadaPor == request.auth.uid
        && getAfter(/databases/$(database)/documents/vehiculos/$(subastaId)).data.publicadorId == request.auth.uid
        && request.resource.data.precioBase is number
        && request.resource.data.precioBase >= 20000
        && request.resource.data.pujaActual == request.resource.data.precioBase
        && request.resource.data.ganadorUid == null
        && request.resource.data.estado == "activa"
        && request.resource.data.horaInicio is timestamp
        && request.resource.data.horaFin is timestamp
        && request.resource.data.horaFin > request.resource.data.horaInicio
        && request.resource.data.horaFin > request.time;

      // PUJAR: dentro del tiempo + incremento minimo del 10%
      allow update: if request.auth != null
        && resource.data.estado == "activa"
        && request.time < resource.data.horaFin
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.precioBase == resource.data.precioBase
        && request.resource.data.horaInicio == resource.data.horaInicio
        && request.resource.data.horaFin == resource.data.horaFin
        && request.resource.data.vehiculoId == resource.data.vehiculoId
        && request.resource.data.creadaPor == resource.data.creadaPor
        && request.resource.data.ganadorUid == request.auth.uid
        && request.resource.data.ultimaPujaEn == request.time
        && (resource.data.ganadorUid == null
              ? request.resource.data.pujaActual >= resource.data.precioBase
              : request.resource.data.pujaActual >= (resource.data.pujaActual * 1.1) - 0.01)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["pujaActual", "ganadorUid", "ultimaPujaEn"]);

      // CERRAR: solo cuando ya vencio el tiempo
      allow update: if request.auth != null
        && resource.data.estado == "activa"
        && request.time >= resource.data.horaFin
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["estado"])
        && (request.resource.data.estado == "desierta"
              ? resource.data.ganadorUid == null
              : request.resource.data.estado == "cerrada"
                && resource.data.ganadorUid != null);

      allow delete: if false;
    }

    // ================= PUJAS (auditoria, sin identidad) =================
    match /pujas/{pujaId} {
      // Solo se muestran montos: la identidad NUNCA se expone
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.timestamp == request.time
        && request.resource.data.subastaId is string
        && getAfter(/databases/$(database)/documents/subastas/$(request.resource.data.subastaId)).data.pujaActual == request.resource.data.monto
        && getAfter(/databases/$(database)/documents/subastas/$(request.resource.data.subastaId)).data.pujaActual
             > get(/databases/$(database)/documents/subastas/$(request.resource.data.subastaId)).data.pujaActual;
      allow update, delete: if false;
    }
  }
}
